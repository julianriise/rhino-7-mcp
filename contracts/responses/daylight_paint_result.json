{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "daylight_paint_result.json",
  "title": "DaylightPaintResult",
  "description": "The overlay mesh id (empty when no faces), faces and welded vertices painted, wires state, the mesh bbox, and old overlay objects deleted first.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "faces": {
      "type": "integer",
      "minimum": 0
    },
    "layer": {
      "type": "string",
      "const": "A-ANALYSE"
    },
    "deleted": {
      "type": "integer",
      "minimum": 0
    },
    "message": {
      "type": "string"
    },
    "vertices": {
      "type": "integer",
      "minimum": 0
    },
    "welded": {
      "type": "boolean"
    },
    "wires": {
      "type": "string",
      "enum": [
        "off",
        "on"
      ]
    },
    "bbox": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "maxItems": 4
    }
  },
  "required": [
    "id",
    "faces",
    "vertices",
    "welded",
    "wires",
    "layer",
    "deleted",
    "bbox",
    "message"
  ],
  "additionalProperties": false
}
