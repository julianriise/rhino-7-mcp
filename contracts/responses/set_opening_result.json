{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "set_opening_result.json",
  "title": "SetOpeningResult",
  "description": "Opening size updated and its host rebuilt. Marker GUID preserved.",
  "type": "object",
  "properties": {
    "marker_id": { "type": "string" },
    "host_id": { "type": "string" },
    "width": { "type": "number" },
    "sill": { "type": "number" },
    "head": { "type": "number" },
    "t": { "type": "number" },
    "ok": { "type": "boolean" },
    "message": { "type": "string" },
    "block_id": { "type": "string", "description": "GUID of the frame after the rebuild, when present." }
  },
  "required": ["marker_id", "host_id", "width", "sill", "head", "ok"]
}
