{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "split_walls_result.json",
  "title": "SplitWallsResult",
  "description": "The whole wall records split into one record per run, and those that stayed whole with the reason.",
  "type": "object",
  "properties": {
    "split": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "forsk_id": { "type": "string", "description": "The record that was split; it is gone." },
          "into": { "type": "array", "items": { "type": "string" }, "description": "The new records' forsk ids, one per run." },
          "openings": { "type": "integer", "description": "Openings moved to the piece that holds them." }
        },
        "required": ["forsk_id", "into", "openings"]
      }
    },
    "walls": { "type": "integer", "description": "New wall records in all." },
    "openings_moved": { "type": "integer" },
    "refused": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "forsk_id": { "type": "string" },
          "why": { "type": "string" }
        },
        "required": ["forsk_id", "why"]
      }
    },
    "ok": { "type": "boolean" },
    "message": { "type": "string" }
  },
  "required": ["split", "walls", "openings_moved", "refused", "ok", "message"]
}
