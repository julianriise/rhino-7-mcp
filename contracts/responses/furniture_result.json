{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "furniture_result.json",
  "title": "FurnitureResult",
  "description": "add_furniture and move_furniture: the piece as placed.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "forsk_id": {
      "type": "string",
      "pattern": "^F[0-9]{2,}$"
    },
    "catalog_id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string"
    },
    "room": {
      "type": "string",
      "description": "The room's id, or empty."
    },
    "centre": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2,
      "description": "The piece's centre [x, y], mm."
    },
    "rotation": {
      "type": "number",
      "description": "Degrees of the back edge from world x, 0 to 360."
    },
    "size": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3,
      "description": "[width, depth, top height] in mm."
    },
    "message": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "forsk_id",
    "catalog_id",
    "name",
    "room",
    "centre",
    "rotation",
    "size",
    "message"
  ]
}
