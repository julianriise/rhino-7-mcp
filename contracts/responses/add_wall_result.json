{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "add_wall_result.json",
  "title": "AddWallResult",
  "description": "One wall added: joined to the record it touched (host rebuilt), or a new record of its own.",
  "type": "object",
  "properties": {
    "host_id": { "type": "string" },
    "forsk_id": { "type": "string" },
    "joined": { "type": "boolean", "description": "True when the wall joined an existing record." },
    "from": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2, "description": "Centreline start after it reached a wall face." },
    "to": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
    "length_mm": { "type": "number" },
    "thickness": { "type": "number" },
    "height": { "type": "number" },
    "path_points": { "type": ["integer", "null"] },
    "holes": { "type": "integer" },
    "host_openings": { "type": "integer" },
    "host_voids": { "type": "integer" },
    "max_frame_mm": { "type": "number" },
    "markers": { "type": "array" },
    "joins": { "type": "array", "items": { "type": "string" }, "description": "A wall standing as its own record: the forsk ids of the records it shares ends with (F2)." },
    "merged": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "forsk_id": { "type": "string" },
          "took_in": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["forsk_id", "took_in"]
      },
      "description": "The new wall merged with a wall on its line: the wall that took it in keeps its id, and host_id and forsk_id name it."
    },
    "ok": { "type": "boolean" },
    "message": { "type": "string" }
  },
  "required": ["host_id", "forsk_id", "joined", "from", "to", "thickness", "holes", "ok", "message"]
}
