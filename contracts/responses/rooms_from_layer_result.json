{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rooms_from_layer_result.json",
  "title": "RoomsFromLayerResult",
  "description": "Planar room markers created from closed room curves",
  "type": "object",
  "properties": {
    "ids": {
      "type": "array",
      "items": { "type": "string" },
      "description": "GUIDs of new room markers"
    },
    "forsk_ids": {
      "type": "array",
      "items": { "type": "string" },
      "description": "forsk:id values parallel to ids (r01, r02, …)"
    },
    "count": { "type": "integer" },
    "source_curves": { "type": "integer" },
    "joined": { "type": "integer" },
    "closed": { "type": "integer" },
    "skipped": { "type": "integer" },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "message": { "type": "string" }
  },
  "required": ["ids", "count", "message"]
}
