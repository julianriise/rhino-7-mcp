{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "move_opening_result.json",
  "title": "MoveOpeningResult",
  "description": "Opening slid along host facade; marker GUID preserved",
  "type": "object",
  "properties": {
    "marker_id": { "type": "string" },
    "host_id": { "type": "string" },
    "t": { "type": "number" },
    "ok": { "type": "boolean" },
    "message": { "type": "string" },
    "block_id": { "type": "string", "description": "GUID of the frame after the move, when rebuilt." }
  },
  "required": ["marker_id", "host_id", "t", "ok"]
}
