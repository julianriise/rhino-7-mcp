{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "layout_pack_result.json",
  "title": "LayoutPackResult",
  "description": "Forsk Layout pages created. count is the page count. scale is the first page's applied denominator.",
  "type": "object",
  "properties": {
    "pages": {
      "type": "array",
      "items": { "type": "object" }
    },
    "count": { "type": "integer" },
    "scale": { "type": "integer" },
    "paper": { "type": "string", "enum": ["A4", "A3", "A2", "A1"], "description": "The paper the set was laid out on." },
    "message": { "type": "string" }
  },
  "required": ["pages", "count", "scale", "message"]
}
