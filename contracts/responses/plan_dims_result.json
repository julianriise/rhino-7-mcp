{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plan_dims_result.json",
  "title": "PlanDimsResult",
  "description": "The stored dimensions after the call, and one line. add also gives the new id, its values and total in mm, and how many picked openings were left off.",
  "type": "object",
  "properties": {
    "dims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "walls": { "type": "integer", "minimum": 0 },
          "openings": { "type": "integer", "minimum": 0 }
        },
        "required": ["id", "walls", "openings"]
      }
    },
    "count": { "type": "integer", "minimum": 0 },
    "id": { "type": "string" },
    "total": { "type": "integer" },
    "values": { "type": "array", "items": { "type": "integer" } },
    "skipped": { "type": "integer", "minimum": 0 },
    "message": { "type": "string" }
  },
  "required": ["dims", "count", "message"]
}
