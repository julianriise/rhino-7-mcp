{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openings_from_layer_result.json",
  "title": "OpeningsFromLayerResult",
  "description": "Door/window openings cut from wall solids, opening_marker ids on A-OPEN, and frame block ids",
  "type": "object",
  "properties": {
    "cut_count": { "type": "integer" },
    "failed_count": { "type": "integer" },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": { "type": "string" },
          "wall_id": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "wall_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "opening_count": { "type": "integer" },
    "marker_ids": {
      "type": "array",
      "description": "GUIDs of opening_marker boxes created on A-OPEN.",
      "items": { "type": "string" }
    },
    "block_ids": {
      "type": "array",
      "description": "GUIDs of forsk:kind=opening frames on A-OPEN::Block, one per marker when the frame was built.",
      "items": { "type": "string" }
    },
    "sill": { "type": "number" },
    "head": { "type": "number" },
    "message": { "type": "string" }
  },
  "required": ["cut_count", "failed_count", "message"]
}
