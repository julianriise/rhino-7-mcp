{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "furnish_result.json",
  "title": "FurnishResult",
  "type": "object",
  "properties": {
    "rooms": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "room": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "added": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "forsk_id": {
                  "type": "string",
                  "pattern": "^F[0-9]{2,}$"
                },
                "catalog_id": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "forsk_id",
                "catalog_id"
              ]
            }
          },
          "skipped": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "why": {
            "type": "string",
            "description": "Empty when furnished, else why not."
          },
          "kept": {
            "type": "integer",
            "minimum": 0,
            "description": "Pieces moved by hand that replace kept."
          }
        },
        "required": [
          "room",
          "type",
          "added",
          "skipped",
          "why"
        ]
      }
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "density": {
      "type": "string"
    },
    "variant": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "preview": {
      "type": "boolean"
    },
    "room": {
      "type": "string"
    },
    "room_words": {
      "type": "string"
    },
    "replace": {
      "type": "boolean"
    },
    "same": {
      "type": "boolean",
      "description": "Both layouts are the same: one is shown."
    },
    "options": {
      "type": "array",
      "description": "Preview only: the consistent and the creative layout.",
      "items": {
        "type": "object",
        "properties": {
          "variant": {
            "type": "string",
            "enum": [
              "consistent",
              "creative"
            ]
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "summary": {
            "type": "string"
          },
          "rooms": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "room": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "pieces": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "skipped": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "why": {
                  "type": "string"
                }
              },
              "required": [
                "room",
                "pieces",
                "why"
              ]
            }
          }
        },
        "required": [
          "variant",
          "count",
          "summary",
          "rooms"
        ]
      }
    }
  },
  "required": [
    "count",
    "message"
  ]
}
