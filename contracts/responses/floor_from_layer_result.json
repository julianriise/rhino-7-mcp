{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "floor_from_layer_result.json",
  "title": "FloorFromLayerResult",
  "description": "Floor slabs created below plan Z",
  "type": "object",
  "properties": {
    "ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "count": { "type": "integer" },
    "source_curves": { "type": "integer" },
    "joined": { "type": "integer" },
    "closed": { "type": "integer" },
    "skipped": { "type": "integer" },
    "thickness": { "type": "number" },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "message": { "type": "string" },
    "material_name": { "type": "string" },
    "objects_updated": { "type": "integer" }
  },
  "required": ["ids", "count", "message"]
}
