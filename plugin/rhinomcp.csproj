<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Rhino 7 line: .NET Framework 4.8 plugin. The Rhino 8 line lives in the
         mcneel-based ktkt40208/RhinoMCP repo. -->
    <TargetFrameworks>net48</TargetFrameworks>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <TargetExt>.rhp</TargetExt>
    <NoWarn>NU1701</NoWarn>
    <LangVersion>11.0</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Specifies information for Assembly and Yak -->
    <!-- Forsk v3, the first public release (Food4Rhino, Rhino 7 for Mac). The assembly
         keeps the file name rhinomcp.rhp and its plug-in GUID, so the dev install,
         the smokes and existing installs carry on. -->
    <Version>1.0.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Title>Forsk</Title>
    <Product>Forsk</Product>
    <Company>Forsk</Company>
    <Copyright>Copyright (c) 2026 Julian Riise. Based on rhinomcp by Jingcheng Chen (MIT).</Copyright>
    <Description>Forsk: architectural drawings for small residential projects in Rhino 7 for Mac, from chat.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.8.0" />
    <!-- 7.33.23306.15001 is not on NuGet (only 7.33 RCs). 7.34 is the oldest
         published 7.x stable after that; still net48 / Rhino 7, not the R8 line. -->
    <PackageReference Include="Grasshopper" Version="7.34.23267.11001" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- v3 R4: IFC4 STEP from plain C# (MIT, netstandard2.0, no dependencies). -->
    <PackageReference Include="GeometryGymIFC_Core" Version="26.9.23" />
    <PackageReference Include="RhinoCommon" Version="7.34.23267.11001" ExcludeAssets="runtime" />
    <!-- Lets the net48 plugin build on a machine without a full .NET Framework
         developer pack (e.g. macOS) — provides the net48 reference assemblies. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- On net48 these are framework assemblies (no NuGet needed, unlike the net8.0
       build which pulled System.Drawing.Common + Microsoft.WindowsDesktop.App.Ref). -->
  <ItemGroup>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Forsk window's page: window.js is inlined into window.html at load. -->
    <EmbeddedResource Include="Forsk/whats_new.json">
      <LogicalName>rhinomcp.Forsk.whats_new.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Forsk/Page/window.html">
      <LogicalName>RhinoMCPPlugin.Page.window.html</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Forsk/Page/window.js">
      <LogicalName>RhinoMCPPlugin.Page.window.js</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Forsk/Page/avatar-planner.svg">
      <LogicalName>RhinoMCPPlugin.Page.avatar-planner.svg</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Forsk/Page/avatar-modeller.svg">
      <LogicalName>RhinoMCPPlugin.Page.avatar-modeller.svg</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Forsk/Page/avatar-plotter.svg">
      <LogicalName>RhinoMCPPlugin.Page.avatar-plotter.svg</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Forsk/Page/avatar-analyser.svg">
      <LogicalName>RhinoMCPPlugin.Page.avatar-analyser.svg</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Forsk/Page/avatar-support.svg">
      <LogicalName>RhinoMCPPlugin.Page.avatar-support.svg</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Forsk/Page/avatar-render.svg">
      <LogicalName>RhinoMCPPlugin.Page.avatar-render.svg</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="EmbeddedResources/plugin-utility.ico">
      <LogicalName>rhinomcp.EmbeddedResources.plugin-utility.ico</LogicalName>
    </EmbeddedResource>
    <!-- Real Shaded export. Patched in memory; imported only when this Rhino cannot export its own. -->
    <EmbeddedResource Include="EmbeddedResources/shaded-export.ini">
      <LogicalName>RhinoMCPPlugin.ForskWhite.shaded-export.ini</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <PropertyGroup>
    <CopyToRhinoPluginDir Condition="'$(CopyToRhinoPluginDir)' == ''">false</CopyToRhinoPluginDir>
    <!-- Rhino 7 Mac scans MacPlugIns for *.rhp *packages* (folders), not the
         Windows-style 7.0/Plug-ins path. The destination is the package folder;
         the assembly rhinomcp.rhp lives inside it. -->
    <RhinoPluginDir Condition="'$(RhinoPluginDir)' == ''">$(HOME)/Library/Application Support/McNeel/Rhinoceros/MacPlugIns/rhinomcp.rhp/</RhinoPluginDir>
  </PropertyGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent"
          Condition="$([MSBuild]::IsOSPlatform('OSX')) And '$(CopyToRhinoPluginDir)' == 'true'">
    <ItemGroup>
      <PluginOutputFiles Include="$(TargetDir)**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginOutputFiles)"
          DestinationFiles="@(PluginOutputFiles->'$(RhinoPluginDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
